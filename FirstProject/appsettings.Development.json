/*******************************
  这个生产环境的配置文件不需要和Java那样子去激活
  只需要在launchSettinas.ison里面"ASPNETCORE_ENVIRONMENT": "Development"即可
  后者会覆盖前者的配置
**********************************/

{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    // 这里的配置会覆盖主配置里的同名连接字符串
    "FirstProjectDB": "Server=127.0.0.1;Database=FirstProjectDb;User Id=sa;Password=你的本地密码;TrustServerCertificate=True"
  }
}
