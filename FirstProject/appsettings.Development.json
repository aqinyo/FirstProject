// 这个生产环境的配置文件不需要和Java那样子去激活，只需要 launchSettinas.ison 里面有 "ASPNETCORE_ENVIRONMENT": "Development" 即可,后者会覆盖前者的配置
{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  // 数据库连接的具体配置值 （dev的配置会覆盖主配置里的同名连接字符串）
  "ConnectionStrings": {
    "firstprojectdb": "Server=127.0.0.1;Port=3306;Database=firstprojectdb;User Id=root;Password=123456"
  },

  // SM4加密算法的密钥配置
  "Crypto": {
    "Sm4Key": "4f8c2d91a6e3b705c1d9f2847a6e0b3c"
  },

  // Jwt 的密钥（补上主配置文件appsetting.json的完整Jwt配置拼图）
  "Jwt": {
    "Key": "qPvE3Rt7sG1Suq/CzZEO0ppRLeN11B0mzt6NZgfsHWk="
  }
}
