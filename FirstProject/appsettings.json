// appsettings.json 是保存“具体配置值”的文件，而 Program.cs 是读取 appsettings.json 内的配置，并注册服务、设置认证和中间件

{
  // 配置日志级别
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  // 允许所有主机访问
  "AllowedHosts": "*",

  // 数据库连接字符串的具体配置值
  "ConnectionStrings": {
    "firstproject": "Server=127.0.0.1;Port=3306;Database=firstprojectdb;User Id=root" //主配置文件里的连接字符串不需要密码，密码可以在开发环境的配置文件里配置，后者会覆盖主配置里的同名连接字符串
  },

  // JWT 的具体配置值（完整有3个，第三个在生产环境的配置文件中）
  "Jwt": {
    "Issuer": "FirstProject", // 颁发者
    "Audience": "FirstProject-api" // 受众
  }

}
