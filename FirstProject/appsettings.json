{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // 主配置里可以写生产环境的服务器地址，或者写一个默认的本地地址
    "FirstProjectDB": "Server=(localdb)\\mssqllocaldb;Database=FirstProjectDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}